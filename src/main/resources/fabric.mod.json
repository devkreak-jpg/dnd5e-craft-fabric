{
  "schemaVersion": 1,
  "id": "dnd-5e-craft",
  "version": "${version}",
  "name": "DnD 5e Craft",
  "description": "D&D 5e rules and virtual tabletop tools for Minecraft.",
  "license": "CC0-1.0",
  "icon": "assets/dnd-5e-craft/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.dnd5ecraft.Dnd5eCraftMod"
    ],
    "client": [
      "net.dnd5ecraft.client.Dnd5eCraftClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "1.20.1",
    "java": ">=17",
    "fabric-api": ">=0.92.12"
  },
  "mixins": [
    "dnd-5e-craft.mixins.json",
    {
      "config": "dnd-5e-craft.client.mixins.json",
      "environment": "client"
    }
  ],
  "authors": [
    "devkreak-jpg"
  ]
}
